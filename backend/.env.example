# Backend .env Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/virtual_queue
FRONTEND_URL=http://localhost:3000
JWT_SECRET=super_secret_jwt_key_12345

# Supabase (PostgreSQL & Realtime)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Twilio SMS & Login OTP (Verify API)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# WhatsApp Cloud API (Optional)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=virtual_queue_wa_webhook

# Email & SMTP Notifications (Gmail, Brevo, SendGrid, Outlook, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="ZeroQ Virtual Queue" <your_email@gmail.com>
